{
  "contract": "typescript-route-synthesis-action-parity-v1",
  "sourceReferences": [
    "tools/contracts/tools-contracts/src/inputs/route_synthesis/route_synthesis.input.model.ts",
    "tools/features/route-synthesis/actions/infer_target.action.ts",
    "tools/features/route-synthesis/actions/discover_handlers.action.ts",
    "tools/features/route-synthesis/actions/create_recipe.action.ts",
    "tools/features/route-synthesis/models/recipe_output_model.ts",
    "tools/core/tools-core/src/recipe_execution_plan.util.ts",
    "tools/core/tools-registry/src/plugin.loader.ts",
    "tools/core/tools-registry/src/models/synthesis/synthesizer_failure.model.ts"
  ],
  "cases": [
    {
      "name": "infer_target success",
      "action": "infer_target",
      "input": {
        "projectRootAbs": "fixture-project",
        "classHint": "example.Work",
        "methodHint": "run"
      },
      "defaults": {
        "discoveryMode": "ranked_candidates",
        "maxCandidates": 8
      },
      "expected": {
        "resultType": "ranked_candidates",
        "status": "ok",
        "shapeAssertions": [
          { "path": "candidates", "size": 1 },
          { "path": "candidates.0.fqcn", "equals": "example.Work" },
          { "path": "candidates.0.methodName", "equals": "run" },
          { "path": "candidates.0.lineSelectionStatus", "equals": "validated" }
        ]
      },
      "ordering": "score descending, then class identity, method identity, line, and file"
    },
    {
      "name": "infer_target missing target",
      "action": "infer_target",
      "input": {
        "projectRootAbs": "fixture-project",
        "classHint": "example.Missing",
        "methodHint": "run"
      },
      "expected": {
        "resultType": "report",
        "status": "target_not_found",
        "reasonCode": "target_not_found",
        "failedStep": "target_inference",
        "nextActionCode": "refine_target_hints"
      }
    },
    {
      "name": "infer_target ambiguity",
      "action": "infer_target",
      "input": {
        "projectRootAbs": "fixture-project",
        "additionalSourceRoots": ["fixture-project/secondary-src"],
        "classHint": "example.Work",
        "methodHint": "run"
      },
      "expected": {
        "resultType": "disambiguation",
        "status": "target_ambiguous",
        "reasonCode": "target_ambiguous",
        "failedStep": "target_selection",
        "nextActionCode": "disambiguate_target"
      },
      "ordering": "class identity, method identity, line, and file"
    },
    {
      "name": "infer_target line-resolution failure",
      "action": "infer_target",
      "input": {
        "projectRootAbs": "fixture-project",
        "classHint": "example.Work",
        "methodHint": "run"
      },
      "expected": {
        "resultType": "report",
        "status": "target_not_found",
        "reasonCode": "runtime_line_unresolved",
        "failedStep": "line_validation",
        "nextActionCode": "select_resolvable_line"
      }
    },
    {
      "name": "infer_target workspace failure",
