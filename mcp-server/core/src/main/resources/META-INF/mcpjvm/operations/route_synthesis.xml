<?xml version="1.0" encoding="UTF-8"?>
<tool name="route_synthesis" formatVersion="2">
  <action classification="synthesis" name="class_methods">
    <summary>Inspect methods for a route-synthesis target.</summary>
    <description>Runs the bounded Java class-methods route synthesis operation.</description>
    <tags>
      <tag>route_synthesis</tag>
      <tag>java</tag>
    </tags>
    <arguments>
      <argument name="projectRootAbs" description="Project root." />
      <argument name="additionalSourceRoots" description="Additional source roots." />
      <argument name="classHint" description="Class hint." />
      <argument name="probeId" description="Probe registry identifier." />
      <argument name="probeBaseUrl" description="Probe base URL override." />
    </arguments>
    <examples>
      <example>{"projectRootAbs":"."}</example>
    </examples>
</action>
  <action classification="synthesis" name="create_recipe">
    <summary>Create a route-synthesis recipe.</summary>
    <description>Builds a bounded Java route recipe from approved synthesis evidence.</description>
    <tags>
      <tag>route_synthesis</tag>
      <tag>java</tag>
    </tags>
    <arguments>
      <argument name="projectRootAbs" description="Project root." />
      <argument name="additionalSourceRoots" description="Additional source roots." />
      <argument name="classHint" description="Class hint." />
      <argument name="methodHint" description="Method hint." />
      <argument name="lineHint" description="Source line hint." />
      <argument name="mappingsBaseUrl" description="Runtime mappings URL." />
      <argument name="discoveryPreference" description="Discovery preference." />
      <argument name="apiBasePath" description="API base path." />
      <argument name="intentMode" description="Execution intent." />
      <argument name="authToken" description="Authentication token." />
      <argument name="authUsername" description="Authentication username." />
      <argument name="authPassword" description="Authentication password." />
      <argument name="actuationEnabled" description="Whether Probe actuation is enabled." />
      <argument name="actuationReturnBoolean" description="Actuation branch value." />
      <argument name="actuationActuatorId" description="Actuation actuator identifier." />
      <argument name="outputTemplate" description="Response output template." />
      <argument name="probeId" description="Probe registry identifier." />
      <argument name="probeBaseUrl" description="Probe base URL override." />
    </arguments>
    <examples>
      <example>{"projectRootAbs":".","classHint":"com.example.Sample","methodHint":"run","intentMode":"line_probe"}</example>
    </examples>
</action>
  <action classification="synthesis" name="discover_handlers">
    <summary>Discover route handlers.</summary>
    <description>Discovers bounded Java route handlers using approved synthesis rules.</description>
    <tags>
      <tag>route_synthesis</tag>
      <tag>java</tag>
    </tags>
    <arguments>
      <argument name="projectRootAbs" description="Project root." />
      <argument name="additionalSourceRoots" description="Additional source roots." />
      <argument name="classHint" description="Class hint." />
      <argument name="probeId" description="Probe registry identifier." />
      <argument name="probeBaseUrl" description="Probe base URL override." />
    </arguments>
    <examples>
      <example>{"projectRootAbs":"."}</example>
    </examples>
</action>
  <action classification="synthesis" name="infer_target">
    <summary>Infer a route-synthesis target.</summary>
    <description>Infers a bounded Java route target from approved evidence.</description>
    <tags>
      <tag>route_synthesis</tag>
      <tag>java</tag>
    </tags>
    <arguments>
      <argument name="projectRootAbs" description="Project root." />
      <argument name="additionalSourceRoots" description="Additional source roots." />
      <argument name="classHint" description="Class hint." />
      <argument name="methodHint" description="Method hint." />
      <argument name="lineHint" description="Source line hint." />
      <argument name="maxCandidates" description="Maximum target candidates." />
      <argument name="probeId" description="Probe registry identifier." />
      <argument name="probeBaseUrl" description="Probe base URL override." />
    </arguments>
    <examples>
      <example>{"projectRootAbs":"."}</example>
    </examples>
</action>
</tool>
