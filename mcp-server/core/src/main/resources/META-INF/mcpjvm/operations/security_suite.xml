<?xml version="1.0" encoding="UTF-8"?>
<tool name="security_suite" formatVersion="2">
  <action classification="suite" name="execute_plan">
    <summary>Execute a security-suite plan.</summary>
    <description>Runs a bounded approved security-suite plan.</description>
    <tags>
      <tag>security_suite</tag>
      <tag>suite</tag>
    </tags>
    <arguments>
      <argument name="projectName" description="Persisted project selector." />
      <argument name="executionProfile" description="Persisted execution profile containing the plan." />
      <argument name="planName" description="Persisted plan name." />
      <argument name="suiteRunId" description="Bounded suite run identifier." />
    </arguments>
    <examples>
      <example>{"projectName":"demo","executionProfile":"smoke","planName":"audit","suiteRunId":"example-run"}</example>
    </examples>
</action>
</tool>
