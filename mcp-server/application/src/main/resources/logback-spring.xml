<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDERR"/>
  </root>

  <logger name="org.springframework.boot.SpringApplication" level="OFF"/>
  <logger name="org.springframework.boot.diagnostics" level="OFF"/>
</configuration>
