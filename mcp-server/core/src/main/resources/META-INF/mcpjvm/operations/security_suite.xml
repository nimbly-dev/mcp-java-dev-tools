<?xml version="1.0" encoding="UTF-8"?>
<tool name="security_suite" formatVersion="2">
  <action classification="suite" name="execute_plan">
    <summary>Execute a security-suite plan.</summary>
    <description>Runs a bounded approved security-suite plan.</description>
    <tags>
      <tag>security_suite</tag>
      <tag>suite</tag>
    </tags>
    <aliases>
      <alias tool="security_suite" action="execute_plan" />
    </aliases>
    <arguments>
      <argument name="metadata" description="Plan metadata." type="object" required="false" />
      <argument name="contract" description="Plan contract." type="object" required="true" />
      <argument name="credentialBindings" description="Credential environment bindings." type="object" required="false" />
      <argument name="credentialSource" description="Credential source metadata." type="object" required="false" />
      <argument name="projectName" description="Project selector." type="string" required="false" />
      <argument name="planName" description="Plan name." type="string" required="false" />
      <argument name="suiteRunId" description="Suite run identifier." type="string" required="false" />
      <argument name="workspaceRootAbs" description="Workspace root." type="string" required="false" />
    </arguments>
    <examples>
      <example>{"contract":{}}</example>
    </examples>
    <safety sideEffect="filesystem_write" confirmationRequired="true" credentialPolicy="caller_must_not_supply_credentials" redactionPolicy="redact_sensitive_fields" timeoutMs="60000" cancellable="true" maxInputBytes="1048576" maxOutputBytes="4194304" />
  </action>
</tool>
