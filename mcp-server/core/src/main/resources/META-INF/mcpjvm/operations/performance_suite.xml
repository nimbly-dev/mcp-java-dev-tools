<?xml version="1.0" encoding="UTF-8"?>
<tool name="performance_suite" formatVersion="2">
  <action classification="suite" name="execute_plan">
    <summary>Execute a performance-suite plan.</summary>
    <description>Runs a bounded approved performance-suite plan.</description>
    <tags>
      <tag>performance_suite</tag>
      <tag>suite</tag>
    </tags>
    <arguments>
      <argument name="projectName" description="Persisted project selector." />
      <argument name="executionProfile" description="Persisted execution profile containing the plan." />
      <argument name="planName" description="Persisted plan name." />
      <argument name="suiteRunId" description="Bounded suite run identifier." />
    </arguments>
    <examples>
      <example>{"projectName":"demo","executionProfile":"smoke","planName":"load","suiteRunId":"example-run"}</example>
    </examples>
</action>
</tool>
