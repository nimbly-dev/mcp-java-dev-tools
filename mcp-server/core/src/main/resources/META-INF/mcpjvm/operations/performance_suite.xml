<?xml version="1.0" encoding="UTF-8"?>
<tool name="performance_suite" formatVersion="2">
  <action classification="suite" name="execute_plan">
    <summary>Execute a performance-suite plan.</summary>
    <description>Runs a bounded approved performance-suite plan.</description>
    <tags>
      <tag>performance_suite</tag>
      <tag>suite</tag>
    </tags>
    <arguments>
      <argument name="projectName" description="Persisted project selector." type="string" required="true" />
      <argument name="executionProfile" description="Persisted execution profile containing the plan." type="string" required="true" />
      <argument name="planName" description="Persisted plan name." type="string" required="true" />
      <argument name="suiteRunId" description="Bounded suite run identifier." type="string" required="true" />
    </arguments>
    <examples>
      <example>{"projectName":"demo","executionProfile":"smoke","planName":"load","suiteRunId":"example-run"}</example>
    </examples>
    <safety sideEffect="filesystem_write" confirmationRequired="true" credentialPolicy="caller_must_not_supply_credentials" redactionPolicy="redact_sensitive_fields" timeoutMs="60000" cancellable="false" maxInputBytes="1048576" maxOutputBytes="4194304" />
  </action>
</tool>
