<?xml version="1.0" encoding="UTF-8"?>
<tool name="regression_suite" formatVersion="2">
  <action classification="suite" name="execute_plan">
    <summary>Execute a regression-suite plan.</summary>
    <description>Runs a bounded approved regression-suite plan.</description>
    <tags>
      <tag>regression_suite</tag>
      <tag>suite</tag>
    </tags>
    <arguments>
      <argument name="projectName" description="Persisted project selector." />
      <argument name="executionProfile" description="Persisted execution profile containing the plan." />
      <argument name="planName" description="Persisted plan name." />
      <argument name="suiteRunId" description="Bounded suite run identifier." />
    </arguments>
    <examples>
      <example>{"projectName":"demo","executionProfile":"smoke","planName":"regression","suiteRunId":"example-run"}</example>
    </examples>
</action>
  <action classification="suite" name="preflight">
    <summary>Preflight a regression-suite plan.</summary>
    <description>Validates readiness for a bounded regression-suite plan.</description>
    <tags>
      <tag>regression_suite</tag>
      <tag>suite</tag>
    </tags>
    <arguments>
      <argument name="projectName" description="Persisted project selector." />
      <argument name="executionProfile" description="Persisted execution profile containing the plan." />
      <argument name="planName" description="Persisted plan name." />
      <argument name="suiteRunId" description="Bounded suite run identifier." />
    </arguments>
    <examples>
      <example>{"projectName":"demo","executionProfile":"smoke","planName":"regression","suiteRunId":"example-run"}</example>
    </examples>
</action>
</tool>
