<?xml version="1.0" encoding="UTF-8"?>
<tool name="execution_orchestration" formatVersion="2">
  <action classification="orchestration" name="execute">
    <summary>Execute an approved persisted execution plan.</summary>
    <description>Runs bounded execution orchestration against approved persisted state.</description>
    <tags>
      <tag>execution_orchestration</tag>
      <tag>execution</tag>
    </tags>
    <aliases>
      <alias tool="execution_orchestration" action="execute" />
    </aliases>
    <arguments>
      <argument name="projectName" description="Project selector." type="string" required="true" />
      <argument name="executionProfile" description="Execution profile." type="string" required="true" />
      <argument name="suiteRunId" description="Suite run identifier." type="string" required="false" />
      <argument name="maxPlansPerCall" description="Maximum plans to execute per call." type="integer" required="false" />
    </arguments>
    <examples>
      <example>{"projectName":"sample","executionProfile":"default"}</example>
    </examples>
    <safety sideEffect="filesystem_write" confirmationRequired="true" credentialPolicy="caller_must_not_supply_credentials" redactionPolicy="redact_sensitive_fields" timeoutMs="60000" cancellable="true" maxInputBytes="1048576" maxOutputBytes="4194304" />
  </action>
</tool>
