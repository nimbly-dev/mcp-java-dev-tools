<?xml version="1.0" encoding="UTF-8"?>
<tool name="execution_profile_export" formatVersion="2">
  <action classification="artifact" name="export">
    <summary>Export a deterministic execution profile.</summary>
    <description>Creates a replayable execution-profile export through the Artifact boundary.</description>
    <tags>
      <tag>execution_profile</tag>
      <tag>export</tag>
    </tags>
    <arguments>
      <argument name="projectName" description="Project selector." />
      <argument name="exportId" description="Export identifier." />
      <argument name="executionProfile" description="Execution profile." />
      <argument name="planName" description="Plan name." />
      <argument name="when" description="Export time hint." />
      <argument name="mode" description="Export mode." />
      <argument name="type" description="Export mode alias." />
      <argument name="includeResolvedSecrets" description="Whether to include resolved secrets." />
      <argument name="includeRuntimeStartup" description="Whether to include runtime startup; omission inherits the workspace default, falling back to true." />
      <argument name="includeHealthcheckGate" description="Whether to include the healthcheck gate; omission inherits the workspace default, falling back to true." />
      <argument name="contextBindings" description="Context to environment bindings." />
      <argument name="contextValues" description="Direct context values." />
    </arguments>
    <examples>
      <example>{}</example>
    </examples>
</action>
</tool>
