<?xml version="1.0" encoding="UTF-8"?>
<tool name="execution_orchestration" formatVersion="2">
  <action classification="orchestration" name="execute">
    <summary>Execute an approved persisted execution plan.</summary>
    <description>Runs bounded execution orchestration against approved persisted state.</description>
    <tags>
      <tag>execution_orchestration</tag>
      <tag>execution</tag>
    </tags>
    <arguments>
      <argument name="projectName" description="Project selector." />
      <argument name="executionProfile" description="Execution profile." />
      <argument name="suiteRunId" description="Suite run identifier." />
      <argument name="maxPlansPerCall" description="Maximum plans to execute per call." />
    </arguments>
    <examples>
      <example>{"projectName":"sample","executionProfile":"default"}</example>
    </examples>
</action>
</tool>
