          { "path": "requestCandidates.0.path", "equals": "/work/run" },
          { "path": "requestCandidates.0.queryTemplate", "equals": "" },
          { "path": "requestCandidates.0.fullUrlHint", "equals": "/work/run" },
          { "path": "requestCandidates.0.assumptions.0", "equals": "spring_mapping_annotation" },
          { "path": "requestCandidates.0.needsConfirmation", "size": 0 },
          { "path": "requestCandidates.0.rationale.0", "equals": "spring_http_handler_annotation" },
          { "path": "selectedHandler.httpMethod", "equals": "GET" },
          { "path": "selectedHandler.path", "equals": "/work/run" },
          { "path": "applicationType", "equals": "spring_http" },
          { "path": "synthesizerUsed", "equals": "spring_http" },
          { "path": "executionReadiness", "equals": "ready" },
          { "path": "intentMode", "equals": "line_probe" },
          { "path": "executionPlan.selectedMode", "equals": "single_line_probe" },
          { "path": "executionPlan.routingReason", "equals": "intent_mode_line_probe" },
          { "path": "executionPlan.steps.0.title", "equals": "Reset probe baseline" },
          { "path": "executionPlan.steps.1.title", "equals": "Execute probe trigger request" },
          { "path": "executionPlan.steps.2.title", "equals": "Verify single-line probe hit" },
          { "path": "executionPlan.probeCallPlan.total", "equals": 2 },
          { "path": "executionPlan.probeCallPlan.byTool.probe_reset", "equals": 1 },
          { "path": "executionPlan.probeCallPlan.byTool.probe_wait_for_hit", "equals": 1 },
          { "path": "auth.status", "equals": "not_required" },
          { "path": "auth.strategy", "equals": "none" },
          { "path": "runtimeCapture.status", "equals": "unavailable" }
        ]
      },
      "ordering": "request candidates and execution steps retain TypeScript order"
    },
    {
