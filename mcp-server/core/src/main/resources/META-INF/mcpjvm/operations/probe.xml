<?xml version="1.0" encoding="UTF-8"?>
<tool name="probe" formatVersion="2">
  <action classification="runtime" name="actuate">
    <summary>Actuate a registered JVM Probe.</summary>
    <description>Executes the bounded Probe endpoint write operation.</description>
    <tags>
      <tag>probe</tag>
      <tag>runtime</tag>
    </tags>
    <arguments>
      <argument name="baseUrl" description="Probe base URL." />
      <argument name="probeId" description="Probe registry identifier." />
      <argument name="action" description="Action value." />
      <argument name="sessionId" description="Session identifier." />
      <argument name="actuatorId" description="Actuator identifier." />
      <argument name="targetKey" description="Strict target key." />
      <argument name="returnBoolean" description="Actuation return value." />
      <argument name="ttlMs" description="Actuation TTL." />
      <argument name="timeoutMs" description="Operation timeout in milliseconds." />
    </arguments>
    <examples>
      <example>{"action":"arm","sessionId":"session-1"}</example>
    </examples>
</action>
  <action classification="runtime" name="capture">
    <summary>Capture a registered JVM Probe result.</summary>
    <description>Reads bounded captured Probe evidence.</description>
    <tags>
      <tag>probe</tag>
      <tag>runtime</tag>
    </tags>
    <arguments>
      <argument name="captureId" description="Capture identifier." />
      <argument name="baseUrl" description="Probe base URL." />
      <argument name="probeId" description="Probe registry identifier." />
      <argument name="timeoutMs" description="Operation timeout in milliseconds." />
    </arguments>
    <examples>
      <example>{"captureId":"capture-1"}</example>
    </examples>
</action>
  <action classification="runtime" name="check">
    <summary>Check a registered JVM Probe endpoint.</summary>
    <description>Performs a bounded Probe endpoint read operation.</description>
    <tags>
      <tag>probe</tag>
      <tag>runtime</tag>
    </tags>
    <arguments>
      <argument name="baseUrl" description="Probe base URL." />
      <argument name="probeId" description="Probe registry identifier." />
      <argument name="http" description="HTTP transport options." />
      <argument name="timeoutMs" description="Operation timeout in milliseconds." />
    </arguments>
    <examples>
      <example>{}</example>
    </examples>
</action>
  <action classification="runtime" name="profiler">
    <summary>Collect a registered JVM Probe profile.</summary>
    <description>Writes bounded profiler evidence through the Probe runtime.</description>
    <tags>
      <tag>probe</tag>
      <tag>profiler</tag>
    </tags>
    <arguments>
      <argument name="action" description="Action value." />
      <argument name="sessionId" description="Session identifier." />
      <argument name="provider" description="Profiler provider." />
      <argument name="event" description="Profiler event." />
      <argument name="intervalNanos" description="Profiler interval." />
      <argument name="outputPath" description="Profiler output path." />
      <argument name="outputFormat" description="Profiler output format." />
      <argument name="baseUrl" description="Probe base URL." />
      <argument name="probeId" description="Probe registry identifier." />
      <argument name="timeoutMs" description="Operation timeout in milliseconds." />
    </arguments>
    <examples>
      <example>{"action":"start"}</example>
    </examples>
</action>
  <action classification="runtime" name="reset">
    <summary>Reset a registered JVM Probe.</summary>
    <description>Executes the bounded Probe endpoint reset operation.</description>
    <tags>
      <tag>probe</tag>
      <tag>runtime</tag>
    </tags>
    <arguments>
      <argument name="key" description="Strict Probe key." />
      <argument name="keys" description="Strict Probe keys." />
      <argument name="lineHint" description="Source line hint." />
      <argument name="className" description="Class selector." />
      <argument name="baseUrl" description="Probe base URL." />
      <argument name="probeId" description="Probe registry identifier." />
      <argument name="timeoutMs" description="Operation timeout in milliseconds." />
    </arguments>
    <examples>
      <example>{"key":"com.example.Sample#run:1"}</example>
    </examples>
</action>
  <action classification="runtime" name="status">
    <summary>Read registered JVM Probe status.</summary>
    <description>Returns bounded status evidence for registered Probe endpoints.</description>
    <tags>
      <tag>probe</tag>
      <tag>runtime</tag>
    </tags>
    <arguments>
      <argument name="key" description="Strict Probe key." />
      <argument name="keys" description="Strict Probe keys." />
      <argument name="lineHint" description="Source line hint." />
      <argument name="baseUrl" description="Probe base URL." />
      <argument name="probeId" description="Probe registry identifier." />
      <argument name="timeoutMs" description="Operation timeout in milliseconds." />
    </arguments>
    <examples>
      <example>{}</example>
    </examples>
</action>
  <action classification="runtime" name="wait_for_hit">
    <summary>Wait for a registered JVM Probe hit.</summary>
    <description>Polls a bounded Probe hit condition with cancellation support.</description>
    <tags>
      <tag>probe</tag>
      <tag>runtime</tag>
    </tags>
    <arguments>
      <argument name="key" description="Strict Probe key." />
      <argument name="lineHint" description="Source line hint." />
      <argument name="baseUrl" description="Probe base URL." />
      <argument name="probeId" description="Probe registry identifier." />
      <argument name="timeoutMs" description="Operation timeout in milliseconds." />
      <argument name="pollIntervalMs" description="Probe polling interval." />
      <argument name="maxRetries" description="Maximum polling retries." />
    </arguments>
    <examples>
      <example>{"key":"com.example.Sample#run:1"}</example>
    </examples>
</action>
</tool>
