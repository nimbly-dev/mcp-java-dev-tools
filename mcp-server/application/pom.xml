<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.nimbly</groupId>
    <artifactId>mcp-java-dev-tools-server-parent</artifactId>
    <version>0.1.9</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>mcp-java-dev-tools-server</artifactId>
  <packaging>jar</packaging>
  <name>mcp-java-dev-tools-server</name>
  <description>Spring Boot STDIO composition boundary for the Java MCP server.</description>

  <dependencies>
    <dependency>
      <groupId>com.nimbly</groupId>
      <artifactId>mcp-java-dev-tools-server-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-mcp-server</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <properties>
    <java.checkstyle.config>${project.basedir}/../config/application-checkstyle.xml</java.checkstyle.config>
    <java.pmd.ruleset>${project.basedir}/../config/pmd-ruleset.xml</java.pmd.ruleset>
    <mcp.sidecar.helper.source>${project.basedir}/../../java-agent/core/core-jvm-attach/target/mcp-java-dev-tools-core-jvm-attach-0.1.8.jar</mcp.sidecar.helper.source>
    <mcp.sidecar.agent.source>${project.basedir}/../../java-agent/core/core-probe/target/mcp-java-dev-tools-agent-0.1.8-all.jar</mcp.sidecar.agent.source>
    <mcp.fixture.social-platform.root>${project.basedir}/../../test/fixtures/spring-apps/social-platform</mcp.fixture.social-platform.root>
    <mcp.fixture.user-app.jar>${mcp.fixture.social-platform.root}/user-service/user-app/target/user-app-0.1.0-SNAPSHOT.jar</mcp.fixture.user-app.jar>
    <mcp.fixture.event-producer-app.jar>${mcp.fixture.social-platform.root}/event-service/event-producer-app/target/event-producer-app-0.1.0-SNAPSHOT.jar</mcp.fixture.event-producer-app.jar>
    <mcp.fixture.event-consumer-app.jar>${mcp.fixture.social-platform.root}/event-service/event-consumer-app/target/event-consumer-app-0.1.0-SNAPSHOT.jar</mcp.fixture.event-consumer-app.jar>
    <mcp.fixture.maven.executable>${maven.home}/bin/mvn</mcp.fixture.maven.executable>
    <mcp.it.groups></mcp.it.groups>
    <mcp.it.skip-fixtures>false</mcp.it.skip-fixtures>
  </properties>

  <build>
    <finalName>mcp-java-dev-tools-server-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.nimbly.mcpjavadevtools.server.McpJavaDevToolsServerApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>

          <execution>
            <id>package-sidecar-artifacts</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <available file="${mcp.sidecar.helper.source}" property="mcp.sidecar.helper.present" />
                <available file="${mcp.sidecar.agent.source}" property="mcp.sidecar.agent.present" />
                <fail unless="mcp.sidecar.helper.present"
                      message="Missing helper artifact: ${mcp.sidecar.helper.source}. Build java-agent core-jvm-attach first." />
                <fail unless="mcp.sidecar.agent.present"
                      message="Missing agent artifact: ${mcp.sidecar.agent.source}. Build java-agent core-probe first." />
                <mkdir dir="${project.build.directory}/sidecar" />
                <copy file="${mcp.sidecar.helper.source}"
                      tofile="${project.build.directory}/sidecar/jvm-attach-helper.jar"
                      preservelastmodified="true" />
                <copy file="${mcp.sidecar.agent.source}"
                      tofile="${project.build.directory}/sidecar/sidecar-agent.jar"
                      preservelastmodified="true" />
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <profiles>
    <profile>
      <id>java-it-performance</id>
      <properties>
        <mcp.it.groups>performance</mcp.it.groups>
      </properties>
    </profile>
    <profile>
      <id>java-it-performance-smoke</id>
      <properties>
        <mcp.it.groups>performance-smoke</mcp.it.groups>
      </properties>
    </profile>
    <profile>
      <id>java-it-regression-postgresql</id>
      <properties>
        <mcp.it.groups>regression-postgresql</mcp.it.groups>
      </properties>
    </profile>
    <profile>
      <id>java-it-regression-fixtures</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>package-regression-fixtures</id>
                <phase>pre-integration-test</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <skip>${mcp.it.skip-fixtures}</skip>
                  <target>
                    <exec executable="${mcp.fixture.maven.executable}" dir="${mcp.fixture.social-platform.root}" failonerror="true" failifexecutionfails="true">
                      <arg value="-B" />
                      <arg value="-pl" />
                      <arg value="post-service/post-app,event-service/event-app,event-service/event-producer-app,event-service/event-consumer-app" />
                      <arg value="-am" />
                      <arg value="package" />
                      <arg value="-DskipTests" />
                    </exec>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>java-it-regression</id>
      <properties>
        <mcp.it.groups>regression</mcp.it.groups>
      </properties>
    </profile>
    <profile>
      <id>java-it-regression-smoke</id>
      <properties>
        <mcp.it.groups>regression-smoke</mcp.it.groups>
      </properties>
    </profile>
    <profile>
      <id>java-it-transport</id>
      <properties>
        <mcp.it.groups>transport</mcp.it.groups>
      </properties>
    </profile>
    <profile>
      <id>java-it-transport-smoke</id>
      <properties>
        <mcp.it.groups>transport-smoke</mcp.it.groups>
      </properties>
    </profile>
    <profile>
      <id>java-it-artifact</id>
      <properties>
        <mcp.it.groups>artifact</mcp.it.groups>
      </properties>
    </profile>
    <profile>
      <id>java-it-artifact-smoke</id>
      <properties>
        <mcp.it.groups>artifact-smoke</mcp.it.groups>
      </properties>
    </profile>
    <profile>
      <id>java-it-failure</id>
      <properties>
        <mcp.it.groups>failure-analysis</mcp.it.groups>
      </properties>
    </profile>
    <profile>
      <id>java-it-failure-smoke</id>
      <properties>
        <mcp.it.groups>failure-smoke</mcp.it.groups>
      </properties>
    </profile>
    <profile>
      <id>java-it-route</id>
      <properties>
        <mcp.it.groups>route-synthesis</mcp.it.groups>
      </properties>
    </profile>
    <profile>
      <id>java-it-route-smoke</id>
      <properties>
        <mcp.it.groups>route-smoke</mcp.it.groups>
      </properties>
    </profile>
    <profile>
      <id>java-it-jvm-smoke</id>
      <properties>
        <mcp.it.groups>jvm-smoke</mcp.it.groups>
      </properties>
    </profile>
    <profile>
      <id>java-it-jvm</id>
      <properties>
        <mcp.it.groups>jvm-probe</mcp.it.groups>
      </properties>
    </profile>
    <profile>
      <id>java-it-jvm-fixtures</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>package-jvm-post-fixture</id>
                <phase>pre-integration-test</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <skip>${mcp.it.skip-fixtures}</skip>
                  <target>
                    <exec executable="${mcp.fixture.maven.executable}" dir="${mcp.fixture.social-platform.root}" failonerror="true" failifexecutionfails="true">
                      <arg value="-B" />
                      <arg value="-pl" />
                      <arg value="post-service/post-app" />
                      <arg value="-am" />
                      <arg value="package" />
                      <arg value="-DskipTests" />
                    </exec>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>java-it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <groups>${mcp.it.groups}</groups>
              <failIfNoTests>true</failIfNoTests>
              <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <systemPropertyVariables>
                <mcpItRepositoryRoot>${project.basedir}/../..</mcpItRepositoryRoot>
                <mcpServerJar>${project.build.directory}/${project.build.finalName}.jar</mcpServerJar>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>java-it-smoke</id>
      <properties>
        <mcp.it.groups>smoke</mcp.it.groups>
      </properties>
    </profile>
    <profile>
      <id>java-it-lifecycle</id>
      <properties>
        <mcp.it.groups>lifecycle</mcp.it.groups>
      </properties>
    </profile>
    <profile>
      <id>java-it-fixtures</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>package-social-platform-user-fixture</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <skip>${mcp.it.skip-fixtures}</skip>
                  <target>
                    <exec executable="${mcp.fixture.maven.executable}" dir="${mcp.fixture.social-platform.root}" failonerror="true" failifexecutionfails="true">
                      <arg value="-B" />
                      <arg value="-pl" />
                      <arg value="user-service/user-app,post-service/post-app,event-service/event-producer-app,event-service/event-consumer-app" />
                      <arg value="-am" />
                      <arg value="package" />
                      <arg value="-DskipTests" />
                    </exec>
                    <available file="${mcp.fixture.user-app.jar}" property="mcp.fixture.user-app.present" />
                    <available file="${mcp.fixture.event-producer-app.jar}" property="mcp.fixture.event-producer-app.present" />
                    <available file="${mcp.fixture.event-consumer-app.jar}" property="mcp.fixture.event-consumer-app.present" />
                    <fail unless="mcp.fixture.user-app.present" message="Fixture build did not produce ${mcp.fixture.user-app.jar}." />
                    <fail unless="mcp.fixture.event-producer-app.present" message="Fixture build did not produce ${mcp.fixture.event-producer-app.jar}." />
                    <fail unless="mcp.fixture.event-consumer-app.present" message="Fixture build did not produce ${mcp.fixture.event-consumer-app.jar}." />
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>skip-fixtures-skipTests</id>
      <activation>
        <property>
          <name>skipTests</name>
          <value>true</value>
        </property>
      </activation>
      <properties>
        <mcp.it.skip-fixtures>true</mcp.it.skip-fixtures>
      </properties>
    </profile>
    <profile>
      <id>skip-fixtures-skipITs</id>
      <activation>
        <property>
          <name>skipITs</name>
          <value>true</value>
        </property>
      </activation>
      <properties>
        <mcp.it.skip-fixtures>true</mcp.it.skip-fixtures>
      </properties>
    </profile>
    <profile>
      <id>skip-fixtures-maven.test.skip</id>
      <activation>
        <property>
          <name>maven.test.skip</name>
          <value>true</value>
        </property>
      </activation>
      <properties>
        <mcp.it.skip-fixtures>true</mcp.it.skip-fixtures>
      </properties>
    </profile>
    <profile>
      <id>windows-maven-executable</id>
      <activation>
        <os>
          <family>Windows</family>
        </os>
      </activation>
      <properties>
        <mcp.fixture.maven.executable>${maven.home}/bin/mvn.cmd</mcp.fixture.maven.executable>
      </properties>
    </profile>
  </profiles>
</project>
