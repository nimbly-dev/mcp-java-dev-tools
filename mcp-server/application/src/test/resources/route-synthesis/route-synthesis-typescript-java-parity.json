        "status": "workspace_context_missing",
        "reasonCode": "workspace_context_missing",
        "failedStep": "workspace_resolution",
        "nextActionCode": "bind_workspace_root"
      }
    },
    {
      "name": "class_methods success with stable ordering",
      "action": "class_methods",
      "input": {
        "projectRootAbs": "fixture-project",
        "classHint": "example.Work"
      },
      "defaults": {
        "discoveryMode": "class_methods"
      },
      "expected": {
        "resultType": "class_methods",
        "status": "ok",
        "shapeAssertions": [
          { "path": "target.fqcn", "equals": "example.Work" },
          { "path": "target.methods.0.methodName", "equals": "before" },
          { "path": "target.methods.1.methodName", "equals": "run" },
          { "path": "target.methods", "size": 2 }
        ]
      },
      "ordering": "method declaration line, then method name"
    },
