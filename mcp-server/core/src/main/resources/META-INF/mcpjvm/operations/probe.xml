<?xml version="1.0" encoding="UTF-8"?>
<tool name="probe" formatVersion="2">
  <action classification="runtime" name="actuate">
    <summary>Actuate a registered JVM Probe.</summary>
    <description>Executes the bounded Probe endpoint write operation.</description>
    <tags>
      <tag>probe</tag>
      <tag>runtime</tag>
    </tags>
    <aliases>
      <alias tool="probe" action="actuate" />
    </aliases>
    <arguments>
      <argument name="baseUrl" description="Probe base URL." type="string" required="false" />
      <argument name="probeId" description="Probe registry identifier." type="string" required="false" />
      <argument name="action" description="Action value." type="string" required="true" />
      <argument name="sessionId" description="Session identifier." type="string" required="true" />
      <argument name="actuatorId" description="Actuator identifier." type="string" required="false" />
      <argument name="targetKey" description="Strict target key." type="string" required="false" />
      <argument name="returnBoolean" description="Actuation return value." type="boolean" required="false" />
      <argument name="ttlMs" description="Actuation TTL." type="integer" required="false" />
      <argument name="timeoutMs" description="Operation timeout in milliseconds." type="integer" required="false" />
    </arguments>
    <examples>
      <example>{"action":"arm","sessionId":"session-1"}</example>
    </examples>
    <safety sideEffect="probe_endpoint_write" confirmationRequired="true" credentialPolicy="caller_must_not_supply_credentials" redactionPolicy="redact_sensitive_fields" timeoutMs="60000" cancellable="true" maxInputBytes="1048576" maxOutputBytes="4194304" />
  </action>
