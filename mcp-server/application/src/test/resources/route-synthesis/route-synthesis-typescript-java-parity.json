          { "path": "handlers.1.httpMethod", "equals": "POST" },
          { "path": "handlers.1.path", "equals": "/work/save" },
          { "path": "handlers.1.methodName", "equals": "save" },
          { "path": "handlers", "size": 2 }
        ]
      },
      "ordering": "resolver handler order is preserved; runtime line metadata is appended"
