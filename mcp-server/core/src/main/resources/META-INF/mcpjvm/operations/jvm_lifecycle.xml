<?xml version="1.0" encoding="UTF-8"?>
<tool name="jvm_lifecycle" formatVersion="2">
  <action classification="runtime" name="list_jvms">
    <summary>List discoverable local JVMs.</summary>
    <description>Returns bounded local JVM candidates without attaching to a process.</description>
    <tags>
      <tag>jvm_lifecycle</tag>
      <tag>runtime</tag>
    </tags>
    <arguments />
    <examples>
      <example>{}</example>
    </examples>
</action>
  <action classification="runtime" name="attach">
    <summary>Attach the repository Sidecar Agent to a JVM.</summary>
    <description>Performs the explicit local JVM lifecycle attach operation.</description>
    <tags>
      <tag>jvm_lifecycle</tag>
      <tag>sidecar</tag>
    </tags>
    <arguments>
      <argument name="pid" description="Target JVM process identifier." />
      <argument name="expectedProcessStartEpochMs" description="Expected JVM start time." />
      <argument name="probeHost" description="Probe host override." />
      <argument name="probePort" description="Probe port override." />
      <argument name="probeId" description="Logical Probe registry identifier emitted with runtime evidence." />
      <argument name="include" description="Probe include selector." />
      <argument name="exclude" description="Probe exclude selector." />
    </arguments>
    <examples>
      <example>{"pid":"1234","expectedProcessStartEpochMs":1}</example>
    </examples>
</action>
  <action classification="runtime" name="deactivate">
    <summary>Deactivate the repository Sidecar Agent from a JVM.</summary>
    <description>Performs the explicit local JVM lifecycle deactivation operation.</description>
    <tags>
      <tag>jvm_lifecycle</tag>
      <tag>sidecar</tag>
    </tags>
    <arguments>
      <argument name="pid" description="Target JVM process identifier." />
      <argument name="expectedProcessStartEpochMs" description="Expected JVM start time." />
    </arguments>
    <examples>
      <example>{"pid":"1234","expectedProcessStartEpochMs":1}</example>
    </examples>
</action>
</tool>
