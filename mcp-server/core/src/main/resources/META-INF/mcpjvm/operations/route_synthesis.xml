<?xml version="1.0" encoding="UTF-8"?>
<tool name="route_synthesis" formatVersion="2">
  <action classification="synthesis" name="class_methods">
    <summary>Inspect methods for a route-synthesis target.</summary>
    <description>Runs the bounded Java class-methods route synthesis operation.</description>
    <tags>
      <tag>route_synthesis</tag>
      <tag>java</tag>
    </tags>
    <aliases>
      <alias tool="route_synthesis" action="class_methods" />
    </aliases>
    <arguments>
      <argument name="projectRootAbs" description="Project root." type="string" required="true" />
      <argument name="additionalSourceRoots" description="Additional source roots." type="array" required="false" />
      <argument name="classHint" description="Class hint." type="string" required="false" />
      <argument name="probeId" description="Probe registry identifier." type="string" required="false" />
      <argument name="probeBaseUrl" description="Probe base URL override." type="string" required="false" />
    </arguments>
    <examples>
      <example>{"projectRootAbs":"."}</example>
    </examples>
    <safety sideEffect="filesystem_read" confirmationRequired="false" credentialPolicy="caller_must_not_supply_credentials" redactionPolicy="redact_sensitive_fields" timeoutMs="60000" cancellable="true" maxInputBytes="1048576" maxOutputBytes="4194304" />
  </action>
  <action classification="synthesis" name="create_recipe">
    <summary>Create a route-synthesis recipe.</summary>
    <description>Builds a bounded Java route recipe from approved synthesis evidence.</description>
    <tags>
      <tag>route_synthesis</tag>
      <tag>java</tag>
    </tags>
    <aliases>
      <alias tool="route_synthesis" action="create_recipe" />
    </aliases>
    <arguments>
      <argument name="projectRootAbs" description="Project root." type="string" required="true" />
      <argument name="additionalSourceRoots" description="Additional source roots." type="array" required="false" />
      <argument name="classHint" description="Class hint." type="string" required="true" />
      <argument name="methodHint" description="Method hint." type="string" required="true" />
      <argument name="lineHint" description="Source line hint." type="integer" required="false" />
      <argument name="mappingsBaseUrl" description="Runtime mappings URL." type="string" required="false" />
      <argument name="discoveryPreference" description="Discovery preference." type="string" required="false" />
      <argument name="apiBasePath" description="API base path." type="string" required="false" />
      <argument name="intentMode" description="Execution intent." type="string" required="true" />
      <argument name="authToken" description="Authentication token." type="string" required="false" />
      <argument name="authUsername" description="Authentication username." type="string" required="false" />
      <argument name="authPassword" description="Authentication password." type="string" required="false" />
      <argument name="actuationEnabled" description="Whether Probe actuation is enabled." type="boolean" required="false" />
      <argument name="actuationReturnBoolean" description="Actuation branch value." type="boolean" required="false" />
      <argument name="actuationActuatorId" description="Actuation actuator identifier." type="string" required="false" />
      <argument name="outputTemplate" description="Response output template." type="string" required="false" />
      <argument name="probeId" description="Probe registry identifier." type="string" required="false" />
      <argument name="probeBaseUrl" description="Probe base URL override." type="string" required="false" />
    </arguments>
    <examples>
      <example>{"projectRootAbs":".","classHint":"com.example.Sample","methodHint":"run","intentMode":"line_probe"}</example>
    </examples>
    <safety sideEffect="filesystem_write" confirmationRequired="true" credentialPolicy="caller_may_supply_credentials" redactionPolicy="redact_sensitive_fields" timeoutMs="60000" cancellable="true" maxInputBytes="1048576" maxOutputBytes="4194304" />
  </action>
